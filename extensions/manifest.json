{
  "manifest_version": 3,
  "name": "Bank Phishing Detector",
  "version": "1.0",

  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://*/*",
    "https://*/*"
  ],

  "action": {
    "default_popup": "popup.html"
  }
}
